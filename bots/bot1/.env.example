#------------------------- BOT INFO ------------------------------

# Master on/off switch for THIS bot instance.
# The launcher skips any bot whose BOT_ENABLED is a falsy value.
# Off values (case-insensitive): 0 | false | no | off | disabled | (empty)
# Missing/anything else = ON. Flip this and restart the launcher to apply.
BOT_ENABLED = on

PREFIX = "."

# Display name shown in embeds/messages
BOT_NAME = "YourBotName"

# Invite link to your support server
SUPPORT_SERVER_URL = https://discord.gg/YOURINVITE

#-------------------------- COLOUR PICKER --------------------------------

# Pick one hex code below (without #) or paste your own
# none   :  2b2d31
# blue   :  518FCB
# cyan   :  5CC9D6
# green  :  4A9D4E
# pink   :  E96391
# red    :  E44E4B
# yellow :  F7E753
# d pink :  e81e62

EMBED_COLOR = 5CC9D6


#-------------------------- BOT CONTROLLERS --------------------------------

# ⚠️ opens hidden commands ( ☠️ DANGER ACCESS ) ‼️
# Comma-separated Discord user IDs of bot owners
# Get your user ID: Discord > Settings > Advanced > Developer Mode ON > right-click your name > Copy ID
BOT_OWNER_IDS = YOUR_DISCORD_USER_ID

#---------------------------- SUPPORT SERVER INFO ----------------------------

# ID of your support/main Discord server
# Right-click server name > Copy Server ID
MAIN_SERVER = "YOUR_SUPPORT_SERVER_ID"

# Backup channel ID inside your support server
# Right-click channel name > Copy Channel ID
BACKUP_CHANNEL_ID = "YOUR_BACKUP_CHANNEL_ID"

# Blacklist log webhook — Server Settings > Integrations > Webhooks > New Webhook
BLACKLIST_WEBHOOK_URL = "YOUR_BLACKLIST_WEBHOOK_URL"


#-------------------------- LOGGING CONFIG --------------------------------

# Master switch — set to false to silence all log output
LOG_ENABLED = true

# Minimum log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL = INFO

# Quick toggle for verbose debug output (overrides LOG_LEVEL → DEBUG)
LOG_DEBUG = false

# Terminal output style: structured (coloured) | simple (plain) | json
LOG_FORMAT = structured

# Write logs to a rotating file in addition to stdout
LOG_TO_FILE = true
LOG_FILE_PATH = logs/bot.log

# Rotation: max file size in bytes (10 MB default) and backup count
LOG_FILE_MAX_BYTES = 10485760
LOG_FILE_BACKUP_COUNT = 5

# Mask sensitive values in all log output
LOG_MASK_SENSITIVE = true
LOG_SENSITIVE_KEYS = token,password,secret,key,auth,webhook



