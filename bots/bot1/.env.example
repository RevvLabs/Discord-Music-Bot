#-------------------------- LAVALINK CONNECTION --------------------------------

# Self-host Lavalink: https://github.com/lavalink-devs/Lavalink
# Or use a public node (search "free lavalink nodes")
NODE_1_URI      = http://your-lavalink-host:2333
NODE_1_PASSWORD = youshallnotpass
NODE_1_REGION   = us

# Uncomment and fill to add a second node
# NODE_2_URI      = http://your-second-node:2333
# NODE_2_PASSWORD = youshallnotpass
# NODE_2_REGION   = eu

# Optional: search/track cache size (default 1024)
# CACHE_CAPACITY = 1024


#-------------------------- CLUSTER / SHARDING (optional) --------------------------------

# The launcher auto-shards based on guild count. Defaults work for most bots —
# only override if you know what you're doing.
# How many guilds one shard handles (default 1200)
# GUILDS_PER_SHARD = 1200
# How many shards run per cluster process (default 3)
# SHARDS_PER_CLUSTER = 3




#------------------------- BOT CONNECTION ------------------------------

# Discord bot token — Developer Portal > Bot > Reset Token
# ⚠️ Never share this with anyone
TOKEN = "YOUR_BOT_TOKEN_HERE"


#------------------------- DATABASE CONNECTION ------------------------------

# PostgreSQL connection string
DATABASE_URL = "postgresql://USERNAME:PASSWORD@localhost:5432/DBNAME"

PG_HOST     = localhost
PG_PORT     = 5432
PG_USER     = YOUR_DB_USER
PG_PASSWORD = YOUR_DB_PASSWORD
PG_DATABASE = YOUR_DB_NAME
